    {
      "cell_type": "code",
      "source": [
        "def set_operations(set1 = None , set2 = None):\n",
        "  if set1 is None :\n",
        "        set1 = set()\n",
        "  if set2 is None:\n",
        "        set2 = set()\n",
        "  union_res = set1 | set2\n",
        "  intersection_res =  set1 & set2\n",
        "  difference_res = set1 - set2\n",
        "  return union_res,intersection_res,difference_res\n",
        "  # example:\n",
        "student_a = {\"math\" , \"physics\",\"python\"}\n",
        "student_b = {\"python\",\"math\",\"chemistry\"}\n",
        "u,i,d = set_operations(set1=student_a,set2=student_b)\n",
        "print(\"Union:\", u)\n",
        "print(\"intersection:\",i)\n",
        "print(\"difference:\",d)\n"
